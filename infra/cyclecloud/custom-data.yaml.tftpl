#cloud-config

write_files:
  - path: /usr/local/sbin/cyclecloud-first-run
    owner: root:root
    permissions: '0700'
    encoding: gz+b64
    content: ${base64gzip(bootstrap_script)}
  - path: /etc/cyclecloud-first-run.env
    owner: root:root
    permissions: '0600'
    content: |
      CYCLECLOUD_ADMIN_USERNAME='${admin_username}'
      CYCLECLOUD_CONTROL_IDENTITY_CLIENT_ID='${control_identity_client_id}'
      AZURE_SUBSCRIPTION_ID='${subscription_id}'
      AZURE_TENANT_ID='${tenant_id}'
      CYCLECLOUD_COMPUTE_RESOURCE_GROUP='${compute_resource_group_name}'
      CYCLECLOUD_BURST_REGION='${burst_region}'
      CYCLECLOUD_LOCKER_STORAGE='${locker_storage_name}'
      CYCLECLOUD_LOCKER_IDENTITY_RESOURCE_ID='${locker_identity_resource_id}'
      CYCLECLOUD_KEY_VAULT_NAME='${key_vault_name}'
      CYCLECLOUD_PRIVATE_NAME='${private_name}'
      CYCLECLOUD_CHEF_PAYLOAD_B64='${chef_payload_base64}'
      CYCLECLOUD_CHEF_MANIFEST_B64='${chef_manifest_base64}'
      CYCLECLOUD_CHEF_SPECIFICATION_B64='${chef_specification_base64}'
      CYCLECLOUD_CHEF_POLICY_LOCK_B64='${chef_policy_lock_base64}'
      CYCLECLOUD_CHEF_PAYLOAD_SHA256='${chef_payload_sha256}'
      CYCLECLOUD_CHEF_MANIFEST_SHA256='${chef_manifest_sha256}'
      CYCLECLOUD_CHEF_SPECIFICATION_SHA256='${chef_specification_sha256}'
      CYCLECLOUD_CHEF_POLICY_LOCK_SHA256='${chef_policy_lock_sha256}'

runcmd:
  - [bash, /usr/local/sbin/cyclecloud-first-run]
