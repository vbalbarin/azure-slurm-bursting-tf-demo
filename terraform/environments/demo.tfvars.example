subscription_id          = "00000000-0000-0000-0000-000000000000"
tenant_id                = "00000000-0000-0000-0000-000000000000"
environment_name         = "slurmdemo"
backend_environment_name = "demo"
source_region            = "eastus"
burst_region             = "southcentralus"
burst_zone               = "1"
alternate_burst_placements = [
  {
    region = "eastus2"
    zone   = "1"
  }
]
source_vnet_cidr = "10.10.0.0/16"
burst_vnet_cidr  = "10.20.0.0/16"

# Existing Microsoft Entra security-group object IDs. Terraform grants these groups
# Key Vault Secrets Officer on the demo vault; replace the placeholder before deployment.
operator_group_object_ids = ["00000000-0000-0000-0000-000000000000"]

# Enable only for the initial secret-creation apply. Replace the documentation
# address with the approved runner's exact /32, then set false/[] and apply a
# separately reviewed hardening plan before acceptance.
key_vault_provisioning_access_enabled = true
key_vault_provisioning_ipv4_cidrs     = ["203.0.113.10/32"]

# Supply scheduler_admin_ssh_public_key and windows_admin_password only through
# sensitive TF_VAR_* environment variables loaded from protected run-state
# files. Never add either value to this file.

cyclecloud_image = {
  publisher = "azurecyclecloud"
  offer     = "azure-cyclecloud"
  sku       = "cyclecloud8-gen2"
  version   = "8.9.320260827"
  plan_name = "cyclecloud8-gen2"
  product   = "azure-cyclecloud"
}

scheduler_image = {
  publisher = "almalinux"
  offer     = "almalinux-x86_64"
  sku       = "9-gen2"
  version   = "9.8.2026100501"
}

burst_compute_image = {
  publisher = "almalinux"
  offer     = "almalinux-hpc"
  sku       = "9-hpc-gen2"
  version   = "9.8.202608110"
}

windows_image = {
  publisher = "MicrosoftWindowsServer"
  offer     = "WindowsServer"
  sku       = "2025-datacenter-azure-edition"
  version   = "26100.33438.260905"
}

cyclecloud_vm_size = "Standard_D4s_v6"
scheduler_vm_size  = "Standard_D4s_v6"
windows_vm_size    = "Standard_D2s_v6"
burst_vm_size      = "Standard_HB120rs_v3"
cyclecloud_vm_count = 1
scheduler_vm_count  = 1
windows_vm_count    = 1
burst_node_count    = 1
cluster_name       = "cross-region-demo"
idle_timeout_minutes = 10
demo_username        = "slurmdemo"
demo_user_uid_gid    = 11200

# Supply these sensitive values through the approved environment-specific input channel.
cyclecloud_certificate_secret_id = "https://example.vault.azure.net/secrets/cyclecloud-tls/version"
chef_policy_archive_uri           = "https://protected.example.invalid/policies"
