{
  "name": "Azure Slurm Bursting",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "2.91.0"
    },
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.6.6"
    },
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.3"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.5",
      "tflint": "0.64.0",
      "terragrunt": "none",
      "installSentinel": false,
      "installTFsec": false,
      "installTerraformDocs": false
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerWorkspaceFolder}/.bundle/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "BUNDLE_GEMFILE": "${containerWorkspaceFolder}/chef/Gemfile"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "chef-software.chef",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "hashicorp.terraform",
        "ms-azuretools.vscode-azureterraform",
        "ms-python.python",
        "ms-vscode.powershell",
        "timonwong.shellcheck"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "rubocop.path": "/home/vscode/.local/bin/cookstyle",
        "terraform.languageServer.enable": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
