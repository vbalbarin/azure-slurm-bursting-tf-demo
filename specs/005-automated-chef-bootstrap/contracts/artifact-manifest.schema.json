{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slurm-demo/artifact-manifest.schema.json",
  "title": "Chef bootstrap artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "sourceRevision",
    "policyName",
    "policyRevision",
    "policyLockSha256",
    "artifacts",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "role": {
      "enum": [
        "cyclecloud",
        "scheduler"
      ]
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policyName": {
      "type": "string",
      "minLength": 1
    },
    "policyRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policyLockSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "version",
          "uri",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "policy",
              "policy-lock",
              "package",
              "project",
              "tool"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^|[/-])latest($|[/?#])"
            }
          },
          "uri": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
