{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slurm-demo/credential-policy.schema.json",
  "title": "Interactive administrator password policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "length",
    "uppercaseAlphabet",
    "lowercaseAlphabet",
    "numericAlphabet",
    "specialAlphabet",
    "minimumPerClass"
  ],
  "properties": {
    "id": {
      "const": "interactive-admin-v1"
    },
    "length": {
      "const": 16
    },
    "uppercaseAlphabet": {
      "const": "ABCDEFGHJKLMNPQRSTUVWXYZ"
    },
    "lowercaseAlphabet": {
      "const": "abcdefghijkmnopqrstuvwxyz"
    },
    "numericAlphabet": {
      "const": "23456789"
    },
    "specialAlphabet": {
      "const": "!@#$%^*()-_+="
    },
    "minimumPerClass": {
      "const": 2
    }
  }
}
