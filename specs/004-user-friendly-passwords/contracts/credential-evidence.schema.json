{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slurm-demo/credential-evidence.schema.json",
  "title": "Secret-free administrative credential evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "policyProfile",
    "targets",
    "newValuePolicyValidated",
    "uniquenessValidated",
    "protectedModesValidated",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "generated",
        "preserved"
      ]
    },
    "policyProfile": {
      "const": "interactive-admin-v1"
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "account",
          "secretName",
          "disposition"
        ],
        "properties": {
          "target": {
            "enum": [
              "windows",
              "cyclecloud"
            ]
          },
          "account": {
            "enum": [
              "windowsadmin",
              "hpcadmin"
            ]
          },
          "secretName": {
            "enum": [
              "windows-admin-password",
              "cyclecloud-admin-password"
            ]
          },
          "disposition": {
            "enum": [
              "generated",
              "preserved"
            ]
          }
        }
      }
    },
    "newValuePolicyValidated": {
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "null"
        }
      ]
    },
    "uniquenessValidated": {
      "const": true
    },
    "protectedModesValidated": {
      "const": true
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
