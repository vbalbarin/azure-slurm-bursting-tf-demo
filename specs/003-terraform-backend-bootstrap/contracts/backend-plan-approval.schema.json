{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/backend-plan-approval.schema.json",
  "title": "Backend Plan Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "source_commit",
    "input_digest",
    "plan_digest",
    "plan_created_at",
    "approved_at",
    "approval_reference"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "enum": ["create", "unlock", "destroy"]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
