{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/backend-readiness-assertions.schema.json",
  "title": "Backend Readiness Assertions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "coordinates_digest",
    "assessment_started_at",
    "assessment_completed_at",
    "execution_context",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "coordinates_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assessment_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_context": {
      "$ref": "#/$defs/execution_context"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_context",
        "backend_exists",
        "container_exists",
        "dns",
        "network",
        "authorization",
        "state_key_separation",
        "migration",
        "locking"
      ],
      "properties": {
        "account_context": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "az_account_show"
                }
              }
            }
          ]
        },
        "backend_exists": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "az_storage_account_show"
                }
              }
            }
          ]
        },
        "container_exists": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "az_storage_container_show"
                }
              }
            }
          ]
        },
        "dns": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "getent_blob_endpoint"
                }
              }
            }
          ]
        },
        "network": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "curl_blob_endpoint"
                }
              }
            }
          ]
        },
        "authorization": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "az_storage_blob_list"
                }
              }
            }
          ]
        },
        "state_key_separation": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "terraform_coordinate_check"
                }
              }
            }
          ]
        },
        "migration": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "terraform_state_pull"
                }
              }
            }
          ]
        },
        "locking": {
          "allOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "properties": {
                "command_id": {
                  "const": "terraform_lock_conflict"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_mode",
        "runner_context_digest",
        "observed_public_source_ipv4",
        "private_network_context_digest",
        "resolved_blob_ipv4_addresses",
        "observed_at"
      ],
      "properties": {
        "network_mode": {
          "enum": ["restricted_public", "private"]
        },
        "runner_context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_public_source_ipv4": {
          "type": ["string", "null"],
          "format": "ipv4"
        },
        "private_network_context_digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "resolved_blob_ipv4_addresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "network_mode": {
                "const": "restricted_public"
              }
            },
            "required": ["network_mode"]
          },
          "then": {
            "properties": {
              "observed_public_source_ipv4": {
                "type": "string",
                "format": "ipv4"
              },
              "private_network_context_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network_mode": {
                "const": "private"
              }
            },
            "required": ["network_mode"]
          },
          "then": {
            "properties": {
              "observed_public_source_ipv4": {
                "type": "null"
              },
              "private_network_context_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "observed_at",
        "exit_code",
        "status",
        "observed_value"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "status": {
          "enum": ["passed", "failed", "not_run"]
        },
        "observed_value": {
          "type": "string",
          "maxLength": 2048
        },
        "detail": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "observed_value": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "observed_value": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
